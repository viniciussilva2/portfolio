# Variáveis de ambiente lidas por config/settings.py.
# Em desenvolvimento nenhuma é obrigatória. Em produção (Cloud Run) elas são
# definidas pela esteira; este arquivo é só a referência.

# "production" liga o modo estrito (a imagem Docker já define).
DJANGO_ENV=development

# Obrigatória em produção. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Domínios aceitos, separados por vírgula. Ex.: meudominio.com.br,www.meudominio.com.br,.run.app
DJANGO_ALLOWED_HOSTS=

# Endereço principal do site, sem "https://". Os outros domínios aceitos
# redirecionam para ele. Vazio = sem redirecionamento. Ex.: meudominio.com.br
DJANGO_CANONICAL_HOST=

# "false" só para rodar a imagem de produção em http://localhost.
DJANGO_HTTPS_ONLY=

# Formulário de contato. Sem EMAIL_HOST, a mensagem é impressa no log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Remetente (precisa ser do domínio verificado no provedor de e-mail).
DEFAULT_FROM_EMAIL=
# Para onde vão as mensagens do formulário.
CONTACT_TO_EMAIL=
