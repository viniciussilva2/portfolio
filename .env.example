# Variáveis de ambiente lidas por config/settings.py.
# Nenhuma é obrigatória: os padrões servem tanto para desenvolver (runserver)
# quanto para gerar o site (manage.py build_static).

# Endereço em que o site publicado responde. Entra no link canônico, nos links
# hreflang, no sitemap e no JSON-LD de cada página gerada.
SITE_URL=https://viniciussilvadev.com.br

# "1" só enquanto o build renderiza o site em arquivos: desliga o debug e usa
# os endereços de produção. O comando build_static exige esta variável.
DJANGO_STATIC_BUILD=

# Força o debug para um valor diferente do padrão (ligado fora do build).
DJANGO_DEBUG=

# O site não tem sessão, login nem formulário: nada é assinado com a chave.
# Ela existe porque o Django pede uma.
DJANGO_SECRET_KEY=
